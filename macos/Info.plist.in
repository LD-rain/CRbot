<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>CRBot</string>
    <key>CFBundleIdentifier</key><string>org.crbot.macos</string>
    <key>CFBundleName</key><string>CRBot</string>
    <key>CFBundleDisplayName</key><string>CRBot</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@CRBOT_VERSION@</string>
    <key>CFBundleVersion</key><string>@CRBOT_BUILD_NUMBER@</string>
    <key>LSMinimumSystemVersion</key><string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>Copyright © 2026 CRBot contributors. GPL-3.0-or-later. Absolutely no warranty.</string>
</dict>
</plist>
