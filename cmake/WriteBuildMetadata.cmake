# Runs once per application build, before either frontend is compiled.
file(MAKE_DIRECTORY "${CRBOT_BINARY_DIR}/generated")
file(LOCK "${CRBOT_BINARY_DIR}/build-number.lock" GUARD PROCESS TIMEOUT 30)
file(STRINGS "${CRBOT_SOURCE_DIR}/VERSION" CRBOT_SEMANTIC_VERSION LIMIT_COUNT 1)
string(STRIP "${CRBOT_SEMANTIC_VERSION}" CRBOT_SEMANTIC_VERSION)
if(NOT CRBOT_SEMANTIC_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "VERSION must contain X.X.X, for example 1.1.0")
endif()
if(NOT CRBOT_RELEASE_CHANNEL MATCHES "^(prerelease|stable)$")
    message(FATAL_ERROR "CRBOT_RELEASE_CHANNEL must be prerelease or stable")
endif()
if(NOT CRBOT_SOURCE_REVISION MATCHES "^([0-9a-fA-F]+|unknown)$")
    message(FATAL_ERROR "CRBOT_SOURCE_REVISION must be a commit SHA or unknown")
endif()

set(counter_file "${CRBOT_BINARY_DIR}/build-number.txt")
set(previous 0)
if(EXISTS "${counter_file}")
    file(READ "${counter_file}" previous)
    string(STRIP "${previous}" previous)
    if(NOT previous MATCHES "^(0|[1-9][0-9]*)$")
        message(FATAL_ERROR "Invalid build counter: ${counter_file}")
    endif()
endif()
if(CRBOT_REQUESTED_BUILD_NUMBER STREQUAL "AUTO")
    math(EXPR CRBOT_BUILD_NUMBER "${previous} + 1")
elseif(CRBOT_REQUESTED_BUILD_NUMBER MATCHES "^[1-9][0-9]*$")
    set(CRBOT_BUILD_NUMBER "${CRBOT_REQUESTED_BUILD_NUMBER}")
else()
    message(FATAL_ERROR "CRBOT_BUILD_NUMBER must be AUTO or a positive integer")
endif()
if(CRBOT_BUILD_NUMBER GREATER previous)
    file(WRITE "${counter_file}" "${CRBOT_BUILD_NUMBER}\n")
endif()

set(CRBOT_DISPLAY_VERSION "${CRBOT_SEMANTIC_VERSION}")
if(CRBOT_RELEASE_CHANNEL STREQUAL "prerelease")
    string(APPEND CRBOT_DISPLAY_VERSION "(${CRBOT_BUILD_NUMBER})")
endif()
configure_file("${CRBOT_SOURCE_DIR}/cmake/crbot_version.h.in"
               "${CRBOT_BINARY_DIR}/generated/crbot_version.h" @ONLY)
configure_file("${CRBOT_SOURCE_DIR}/cmake/build-info.json.in"
               "${CRBOT_BINARY_DIR}/build-info.json" @ONLY)
if(CRBOT_MACOS_GUI)
    set(CRBOT_VERSION "${CRBOT_SEMANTIC_VERSION}")
    set(CMAKE_OSX_DEPLOYMENT_TARGET "${CRBOT_MACOS_MIN_VERSION}")
    configure_file("${CRBOT_SOURCE_DIR}/macos/Info.plist.in"
                   "${CRBOT_BINARY_DIR}/CRBot.app/Contents/Info.plist" @ONLY)
endif()
message(STATUS "CRBot ${CRBOT_DISPLAY_VERSION} [${CRBOT_RELEASE_CHANNEL}, build ${CRBOT_BUILD_NUMBER}]")
